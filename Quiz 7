# Formula: residual_i = observed y_i - fitted y_i.
x_q23 <- c(1, 2, 3, 7, 9)
y_q23 <- c(8, 4, 5, 12, 4)
model_q23 <- lm(y_q23 ~ x_q23)
fitted_third_q23 <- as.numeric(predict(model_q23, newdata = data.frame(x_q23 = 3)))
