# GROUP F - Concepts
# ==============================================================

# F1. Does E[U | class size] = 0 hold?
#   NO. Family income is omitted (so it sits inside U) and is negatively
#   correlated with class size (richer districts have smaller classes).
#   So U is correlated with class size, and E[U | class size] depends on
#   class size instead of equaling zero.

# F2. Which line is the OLS line?
#   Line C. OLS requires sum(u_hat) = 0 AND minimizes sum(u_hat^2).
#   Line C has sum(u_hat) = 0.00 and the smallest sum of squared residuals (5.33).
#   The other columns are not enough: sum(u_hat) = 0 holds for many non-OLS
#   lines (e.g., Line A), and sum(|u_hat|) measures absolute error (LAD),
#   not squared error.

# ==============================================================
# GROUP G - Units and Changes
# ==============================================================

# G1. Correlation if income is measured in thousands of dollars: 0.35
#   Correlation is unitless / scale-invariant. Quick demonstration:
set.seed(377)
income <- rnorm(100, 50000, 10000)
other  <- 0.00005 * income + rnorm(100)
cat("G1: cor (dollars)   =", round(cor(income, other), 4), "\n")
cat("G1: cor (thousands) =", round(cor(income / 1000, other), 4), "\n")  # identical
cat("G1: answer stays 0.35\n")

# G2. X1 rises by 4, X2 falls by 3; beta1 = 1.5, beta2 = -0.8
b1 <- 1.5; b2 <- -0.8
delta_y <- b1 * 4 + b2 * (-3)
cat("G2: change in y =", round(delta_y, 2), "\n")     # 8.40
