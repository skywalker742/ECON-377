# ==============================================================
# GROUP A - Variance Rules
# ==============================================================

# A1. sd(3X - 7), given E[X] = 2, E[X^2] = 20
EX   <- 2
EX2  <- 20
VarX <- EX2 - EX^2                    # 16
sdX  <- sqrt(VarX)                    # 4
sd_3X_7 <- abs(3) * sdX               # 12
sd_3X_7

# A2. Var(3X - 2Y), given Var(X) = 5, Var(Y) = 8, Cov(X,Y) = -2
VarX <- 5
VarY <- 8
CovXY <- -2
a <- 3
b <- -2
Var_3X_2Y <- a^2 * VarX + b^2 * VarY + 2 * a * b * CovXY  # 101
Var_3X_2Y

# ==============================================================
# GROUP B - Probability Tables
# ==============================================================

# B1. Cor(X, Y), given joint distribution table
xv <- c(1, 2, 4, 5)
yv <- c(2, 6, 3, 7)
p  <- c(0.2, 0.3, 0.4, 0.1)

EX <- sum(p * xv)                     # 2.9
EY <- sum(p * yv)                     # 4.1
CovXY <- sum(p * xv * yv) - EX * EY   # 0.41
VarX  <- sum(p * xv^2) - EX^2         # 1.89
VarY  <- sum(p * yv^2) - EY^2         # 3.29
CorXY <- CovXY / sqrt(VarX * VarY)    # 0.1644
CorXY

# B2 (a). E[3Y - 2 | X = x], given conditional distribution Y | X=x
yv <- c(4, 10, 16)
pc <- c(0.25, 0.5, 0.25)
EYx <- sum(pc * yv)                   # E[Y | X = x] = 10
E_3Y_2_given_X <- 3 * EYx - 2         # 28
E_3Y_2_given_X

# B2 (b). Var(Y | X = x)
VarYx <- sum(pc * yv^2) - EYx^2        # 18
VarYx

# ==============================================================
# GROUP C - OLS Residuals
# ==============================================================

# C1. Residual of 4th observation, (x4, y4) = (7, 9)
x <- c(2, 3, 5, 7, 8)
y <- c(3, 6, 5, 9, 12)
reg_C1 <- lm(y ~ x)
u4 <- reg_C1$residuals[4]             # -0.5385
u4

# C2 (a). Missing 6th residual u6
res_5 <- c(1.4, -0.6, -2.3, 0.9, 1.1)
u6 <- -sum(res_5)                     # -0.5
u6

# C2 (b). sum(x_i * u_hat_i)
sum_xu <- sum(x * reg_C1$residuals)   # 0
sum_xu

# ==============================================================
# GROUP D - Sums of Squares
# ==============================================================

# D1. SSR, given SSE = 120 and R^2 = 0.4
SSE <- 120
R2  <- 0.4
SST <- SSE / R2                       # 300
SSR <- SST - SSE                      # 180
SSR

# D2 (a). SST, given n = 31, s2y = 9
n <- 31
s2y <- 9
SST_D2 <- (n - 1) * s2y               # 270
SST_D2

# D2 (b). R^2, given SSR = 189
SSR_D2 <- 189
R2_D2 <- 1 - (SSR_D2 / SST_D2)         # 0.30
R2_D2


