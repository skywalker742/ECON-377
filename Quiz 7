# GROUP A - Variance Rules
# ==============================================================

# A1. sd(3X - 7), given E[X] = 2, E[X^2] = 20
EX   <- 2
EX2  <- 20
VarX <- EX2 - EX^2                    # 16
sdX  <- sqrt(VarX)                    # 4
sd_3X_7 <- abs(3) * sdX               # 12
sd_3X_7

# A2. Var(3X - 2Y), given Var(X) = 5, Var(Y) = 8, Cov(X,Y) = -2
VarX <- 5
VarY <- 8
CovXY <- -2
a <- 3
b <- -2
Var_3X_2Y <- a^2 * VarX + b^2 * VarY + 2 * a * b * CovXY  # 101
Var_3X_2Y

# ==============================================================
# GROUP B - Probability Tables
# ==============================================================

# B1. Cor(X, Y), given joint distribution table
xv <- c(1, 2, 4, 5)
yv <- c(2, 6, 3, 7)
p  <- c(0.2, 0.3, 0.4, 0.1)

EX <- sum(p * xv)                     # 2.9
EY <- sum(p * yv)                     # 4.1
CovXY <- sum(p * xv * yv) - EX * EY   # 0.41
VarX  <- sum(p * xv^2) - EX^2         # 1.89
VarY  <- sum(p * yv^2) - EY^2         # 3.29
CorXY <- CovXY / sqrt(VarX * VarY)    # 0.1644
CorXY

# B2 (a). E[3Y - 2 | X = x], given conditional distribution Y | X=x
yv <- c(4, 10, 16)
pc <- c(0.25, 0.5, 0.25)
EYx <- sum(pc * yv)                   # E[Y | X = x] = 10
E_3Y_2_given_X <- 3 * EYx - 2         # 28
E_3Y_2_given_X

# B2 (b). Var(Y | X = x)
VarYx <- sum(pc * yv^2) - EYx^2        # 18
VarYx

