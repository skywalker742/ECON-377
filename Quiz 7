res_worker6

# E2 (a). Explained sum of squares SSE for ceosal1
data("ceosal1")
reg_E2 <- lm(salary ~ roe, data = ceosal1)
SST_E2 <- sum((ceosal1$salary - mean(ceosal1$salary))^2)
SSR_E2 <- sum(reg_E2$residuals^2)
SSE_E2 <- SST_E2 - SSR_E2             # 2933703
SSE_E2

# E2 (b). Percentage variation explained (% R^2)
pct_explained <- 100 * summary(reg_E2)$r.squared  # 1.3188
pct_explained


