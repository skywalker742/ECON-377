# ==============================================================
# GROUP A - Variance Rules
# ==============================================================

# A1. sd(3X - 7), given E[X] = 2, E[X^2] = 20
EX   <- 2
EX2  <- 20
VarX <- EX2 - EX^2                    # 16
sdX  <- sqrt(VarX)                    # 4
sd_3X_7 <- abs(3) * sdX               # 12
cat("A1: sd(3X - 7) =", round(sd_3X_7, 2), "\n")     # 12.00

# A2. Var(3X - 2Y), Var(X)=5, Var(Y)=8, Cov(X,Y)=-2
VarX <- 5; VarY <- 8; CovXY <- -2
a <- 3; b <- -2
Var_3X_2Y <- a^2 * VarX + b^2 * VarY + 2 * a * b * CovXY
cat("A2: Var(3X - 2Y) =", round(Var_3X_2Y, 2), "\n")  # 101.00

# ==============================================================
# GROUP B - Probability Tables
# ==============================================================

# B1. Cor(X, Y)
xv <- c(1, 2, 4, 5)
yv <- c(2, 6, 3, 7)
p  <- c(0.2, 0.3, 0.4, 0.1)

EX    <- sum(p * xv)                  # 2.9
EY    <- sum(p * yv)                  # 4.1
CovXY <- sum(p * xv * yv) - EX * EY   # 0.41
VarX  <- sum(p * xv^2) - EX^2         # 1.89
VarY  <- sum(p * yv^2) - EY^2         # 3.29
CorXY <- CovXY / sqrt(VarX * VarY)
cat("B1: Cor(X,Y) =", round(CorXY, 2), "\n")          # 0.16

# B2. Conditional distribution of Y given X = x
yv_c <- c(4, 10, 16)
pc   <- c(0.25, 0.5, 0.25)

EYx   <- sum(pc * yv_c)                       # 10
E_3Y_2_given_X <- 3 * EYx - 2                 # (a) 28
VarYx <- sum(pc * yv_c^2) - EYx^2             # (b) 18
cat("B2(a): E[3Y - 2 | X = x] =", round(E_3Y_2_given_X, 2), "\n")  # 28.00
cat("B2(b): Var(Y | X = x)    =", round(VarYx, 2), "\n")           # 18.00

# ==============================================================
# GROUP C - OLS Residuals
# ==============================================================

# C1. Residual of the 4th observation (x4, y4) = (7, 9)
x <- c(2, 3, 5, 7, 8)
y <- c(3, 6, 5, 9, 12)
reg_C1 <- lm(y ~ x)
coef(reg_C1)                                   # intercept 0.6538, slope 1.2692
cat("C1: residual of obs 4 =", round(reg_C1$residuals[4], 2), "\n")  # -0.54

# C2. (a) Missing 6th residual (residuals must sum to 0)
res_5 <- c(1.4, -0.6, -2.3, 0.9, 1.1)
u6 <- -sum(res_5)
cat("C2(a): u6 =", round(u6, 2), "\n")                # -0.50

# C2. (b) sum(x_i * u_i) = 0 by the OLS first-order conditions
# (verified numerically on the C1 regression)
sum_xu <- sum(x * reg_C1$residuals)
cat("C2(b): sum(x * u_hat) =", round(sum_xu, 2), "\n")  # 0.00

# ==============================================================
# GROUP D - Sums of Squares
# ==============================================================

# D1. SSE = 120, R^2 = 0.4  ->  SSR
SSE <- 120; R2 <- 0.4
SST <- SSE / R2                       # 300
SSR <- SST - SSE                      # 180
cat("D1: SSR =", round(SSR, 2), "\n")                 # 180.00

# D2. n = 31, s_y^2 = 9, SSR = 189
n <- 31; s2y <- 9; SSR_D2 <- 189
SST_D2 <- (n - 1) * s2y               # (a) 270
R2_D2  <- 1 - SSR_D2 / SST_D2         # (b) 0.30
cat("D2(a): SST =", round(SST_D2, 2), "\n")           # 270.00
cat("D2(b): R^2 =", round(R2_D2, 2), "\n")            # 0.30

# ==============================================================
# GROUP E - Real Data in R
# ==============================================================

# E1. Regress wage on tenure (wage1); residual of row 6 worker
data("wage1")
reg_E1 <- lm(wage ~ tenure, data = wage1)
cat("E1: residual of row 6 =", round(reg_E1$residuals[6], 2), "\n")

# E2. Regress salary on roe (ceosal1)
data("ceosal1")
reg_E2 <- lm(salary ~ roe, data = ceosal1)

# (a) Explained sum of squares: SSE = SST - SSR
SST_E2 <- sum((ceosal1$salary - mean(ceosal1$salary))^2)
SSR_E2 <- sum(reg_E2$residuals^2)
SSE_E2 <- SST_E2 - SSR_E2

# (b) Percent of variation explained = 100 * R^2
pct_explained <- 100 * summary(reg_E2)$r.squared

cat("E2(a): SSE (explained SS) =", round(SSE_E2, 2), "\n")
cat("E2(b): % variation explained =", round(pct_explained, 2), "\n")

