# Problem Set 9 (second attempt)
install.packages("wooldridge")   # run once if needed
library(wooldridge)

# Question 1:
# A log-log regression of CEO salary on firm sales gives log(salary) = beta0_hat + beta1_hat * log(sales), 
# with salary in thousands of dollars. Salary is then measured in dollars instead. What happens?
q1_answer <- "beta1_hat does not change; only beta0_hat changes."
print(q1_answer)

# Question 2:
# A log-level regression of log(wage) on tenure, with tenure measured in months, gives a slope of 0.0057. 
# By about what percent does wage rise with one more year of tenure? (Give a percent, e.g. 12.34 for 12.34%.) (round to the hundredths)
# Hint: one year is 12 months, so delta x = 12. Use the log-level row of Table 2.3.
beta1_hat_q2 <- 0.0057
delta_x_q2 <- 12
pct_wage_rise_q2 <- 100 * beta1_hat_q2 * delta_x_q2
round(pct_wage_rise_q2, 2)

# Question 3:
# A regression gives log(salary) = 3.92 + 0.13 log(sales), with salary in thousands of dollars. 
# If salary is measured in dollars instead (every salary times 1000), what is the new intercept? (round to the hundredths)
# Hint: log(1000 * y) = log(1000) + log(y), and log(1000) = 6.91 (in R: log(1000)).
beta0_hat_q3 <- 3.92
beta0_new_q3 <- beta0_hat_q3 + log(1000)
round(beta0_new_q3, 2)

# Question 4:
# In which model is the slope read as % delta y approx 100 * beta1 * delta x?
q4_answer <- "log-level: log(y) = beta0 + beta1*x + u"
print(q4_answer)

# Question 5:
# A log-log regression gives log(y)_hat = 1.4 + 0.17 log(x). By about what percent does y change when x falls by 5%? (Give a percent; it can be negative.) (round to the hundredths)
# Hint: log-log: % delta y approx beta1_hat * % delta x and a fall means % delta x is negative.
beta1_hat_q5 <- 0.17
pct_delta_x_q5 <- -5
pct_delta_y_q5 <- beta1_hat_q5 * pct_delta_x_q5
round(pct_delta_y_q5, 2)

# Question 6:
# Data: ceosal1 (salary = a CEO's 1990 salary in thousands of dollars; roe = the firm's return on equity, in percent; sales = firm sales in millions of dollars). 
# Run the log-level regression lm(log(salary) ~ roe, data = ceosal1). 
# By about what percent does predicted salary change when return on equity rises by 5 points? (Give a percent. Use the unrounded slope.) (round to the hundredths)
# Hint: use the log-level row of Table 2.3 with delta roe = 5
data("ceosal1")
reg_q6 <- lm(log(salary) ~ roe, data = ceosal1)
beta1_hat_q6 <- unname(coef(reg_q6)["roe"])
delta_roe_q6 <- 5
pct_change_q6 <- 100 * beta1_hat_q6 * delta_roe_q6
round(pct_change_q6, 2)

# Question 7:
# Data: ceosal1 (salary = a CEO's 1990 salary in thousands of dollars; roe = the firm's return on equity, in percent; sales = firm sales in millions of dollars). 
# Run the level-log regression lm(salary ~ log(sales), data = ceosal1). 
# By about how many thousand dollars does predicted salary change when sales rise by 10%? (Use the unrounded slope.) (round to the hundredths)
# Hint: level-log: delta y approx (beta1_hat / 100) * % delta x (Table 2.3). Salary is already in thousands of dollars.
reg_q7 <- lm(salary ~ log(sales), data = ceosal1)
beta1_hat_q7 <- unname(coef(reg_q7)["log(sales)"])
pct_delta_sales_q7 <- 10
delta_salary_q7 <- (beta1_hat_q7 / 100) * pct_delta_sales_q7
round(delta_salary_q7, 2)

