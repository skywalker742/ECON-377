# Question 11:
# Under SLR1-SLR5, the error variance is sigma^2 = 167 and SST_X = 25. Find Var(beta1_hat). (round to the hundredths)
# Hint: Theorem 2.2: Var(beta1_hat) = sigma^2 / SST_X
sigma2_q11 <- 167
sst_x_q11 <- 25
var_beta1_hat_q11 <- sigma2_q11 / sst_x_q11
round(var_beta1_hat_q11, 2)

# Question 12:
# Under SLR1-SLR5, the error standard deviation is sigma = 13. A sample has n = 10 observations, and the sample variance of X is S_X^2 = 6. 
# Find sd(beta1_hat). (round to the hundredths)
# Hint: SST_X = (n - 1) * S_X^2, then sd(beta1_hat) = sigma / sqrt(SST_X).
sigma_q12 <- 13
n_q12 <- 10
sx2_q12 <- 6
sst_x_q12 <- (n_q12 - 1) * sx2_q12
sd_beta1_hat_q12 <- sigma_q12 / sqrt(sst_x_q12)
round(sd_beta1_hat_q12, 2)

# Question 13:
# Holding everything else fixed, which change makes Var(beta1_hat) smaller?
q13_answer <- "More spread-out values of X (a larger SST_X)."
print(q13_answer)

# Question 14:
# Under SLR1-SLR5, the error standard deviation is sigma = 2. A sample has the five X values x = (1, 2, 3, 7, 8). 
# Find sd(beta1_hat). (round to the hundredths)
# Hint: first SST_X = sum((x - mean(x))^2), then sd(beta1_hat) = sigma / sqrt(SST_X).
sigma_q14 <- 2
x_q14 <- c(1, 2, 3, 7, 8)
sst_x_q14 <- sum((x_q14 - mean(x_q14))^2)
sd_beta1_hat_q14 <- sigma_q14 / sqrt(sst_x_q14)
round(sd_beta1_hat_q14, 2)

# Question 15:
# A simple regression on n = 53 observations has SSR = 238. Find the estimate of the error variance, sigma2_hat. (round to the hundredths)
# Hint: sigma2_hat = SSR / (n - 2): divide by n - 2, not n or n - 1.
n_q15 <- 53
ssr_q15 <- 238
sigma2_hat_q15 <- ssr_q15 / (n_q15 - 2)
round(sigma2_hat_q15, 2)

# Question 16:
# A simple regression on n = 10 observations has SSR = 804 and SST_X = 28. 
# Find the standard error se(beta1_hat). (round to the hundredths)
# Hint: first sigma_hat = sqrt(SSR / (n - 2)), then se(beta1_hat) = sigma_hat / sqrt(SST_X)
n_q16 <- 10
ssr_q16 <- 804
sst_x_q16 <- 28
sigma_hat_q16 <- sqrt(ssr_q16 / (n_q16 - 2))
se_beta1_hat_q16 <- sigma_hat_q16 / sqrt(sst_x_q16)
round(se_beta1_hat_q16, 2)

