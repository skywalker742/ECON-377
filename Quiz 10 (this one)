# PART 4: SIMPLE VS. MULTIPLE REGRESSION & FORMULA (3.23) (Questions 11 - 15)
# ==============================================================================

# Question 11 (Quiz 10):
# Formula (3.23): beta1_tilde = beta1_hat + beta2_hat * delta1_tilde.
# The simple regression of Y on X1 gives beta1_tilde = -0.36. The multiple regression
# gives beta2_hat = -1.18, and the slope from regressing X2 on X1 is delta1_tilde = -0.51.
# Find the multiple-regression slope beta1_hat.
# Hint: solve (3.23) for beta1_hat: beta1_hat = beta1_tilde - beta2_hat * delta1_tilde
beta1_tilde_q11 <- -0.36
beta2_hat_q11 <- -1.18
delta1_tilde_q11 <- -0.51
beta1_hat_q11 <- beta1_tilde_q11 - beta2_hat_q11 * delta1_tilde_q11
round(beta1_hat_q11, 2)



# Question 14 (Quiz 10):
# Data: bwght. Regress faminc on cigs to get delta1_tilde. Compute beta2_hat * delta1_tilde,
# the faminc coefficient from the multiple regression times this slope.
# Hint: by (3.23), beta2_hat * delta1_tilde = beta1_tilde - beta1_hat. Use that to check.
reg_q14 <- lm(faminc ~ cigs, data = bwght)
reg_simple_q14 <- lm(bwght ~ cigs, data = bwght)
reg_multiple_q14 <- lm(bwght ~ cigs + faminc, data = bwght)
delta1_tilde_q14 <- unname(coef(reg_q14)["cigs"])
beta2_hat_q14 <- unname(coef(reg_multiple_q14)["faminc"])
product_q14 <- beta2_hat_q14 * delta1_tilde_q14
round(product_q14, 2)

# Check with (3.23): simple cigs slope minus multiple-regression cigs slope
beta1_tilde_q14 <- unname(coef(reg_simple_q14)["cigs"])
beta1_hat_q14 <- unname(coef(reg_multiple_q14)["cigs"])
round(beta1_tilde_q14 - beta1_hat_q14, 2)


# ==============================================================================
# PART 5: DIRECTION OF OMITTED-VARIABLE BIAS (Questions 16 - 19)
# ==============================================================================
# Table 3.2: Bias(beta1_tilde) = beta2 * delta1_tilde, and delta1_tilde has the
# sign of Cor(X1, X2).

# Question 16 (Quiz 10):
# An omitted variable X2 lowers Y (beta2 < 0), and X2 is negatively correlated with
# the included X1 (delta1_tilde < 0). The simple-regression slope on X1 is:
beta2_sign_q16   <- -1
delta1_sign_q16  <- -1
bias_sign_q16 <- beta2_sign_q16 * delta1_sign_q16   # +1 means upward bias
bias_sign_q16
q16_answer <- "biased upward"
print(q16_answer)

#   OMITTED-VARIABLE BIAS: bias = beta2 * delta1   (Q16 and Q17)
#   beta2:  does omitted X2 raise (+) or lower (-) Y?
#   delta1: do X1 and X2 move together (+) or opposite ways (-)?
#
#                    delta1 > 0     delta1 < 0
#   beta2 > 0        UPWARD         DOWNWARD
#   beta2 < 0        DOWNWARD       UPWARD
#   If beta2 = 0 or delta1 = 0: NO bias
#
#   "Overstates" or "understates" in the answer? Use the true effect's sign:
#                    Upward bias    Downward bias
#   True effect > 0  OVERSTATES     UNDERSTATES
#   True effect < 0  UNDERSTATES    OVERSTATES

# Question 17 (Quiz 10):
# A researcher regresses crop yield on fertilizer use, leaving out land quality.
# Better land raises yield (beta2 > 0), and farmers use more fertilizer on better land
# (delta1_tilde > 0). The simple-regression fertilizer slope most likely:
beta2_sign_q17   <- 1
delta1_sign_q17  <- 1
bias_sign_q17 <- beta2_sign_q17 * delta1_sign_q17
bias_sign_q17
q17_answer <- "overstates the effect of fertilizer (upward bias)"
print(q17_answer)
