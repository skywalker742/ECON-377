# Question 1 (Quiz 10):
# A regression gives log(y_hat) = 1.9 + 0.052 * x1 - 0.013 * x2.
# If x1 rises by 4 and x2 rises by 4, by about what percent does predicted y change?
# Hint: log-level MLR: % delta y approx 100 * (beta1_hat * delta_x1 + beta2_hat * delta_x2)
b1_q1 <- 0.052
b2_q1 <- -0.013
delta_x1_q1 <- 4
delta_x2_q1 <- 4
pct_change_y_q1 <- 100 * (b1_q1 * delta_x1_q1 + b2_q1 * delta_x2_q1)
round(pct_change_y_q1, 2)


# Question 2 (Quiz 10):
# Data: wage1. Run reg <- lm(log(wage) ~ educ + exper + tenure, data = wage1).
# By about what percent does predicted wage change when experience rises by 2 years
# and tenure rises by 1 year, holding education fixed? (Use unrounded coefficients.)
# Hint: % delta wage approx 100 * (beta_exper * 2 + beta_tenure * 1)
data("wage1")
reg <- lm(log(wage) ~ educ + exper + tenure, data = wage1)
b <- reg$coefficients
pct_change_wage_q2 <- 100 * (b[3] * 2 + b[4] * 1)
round(unname(pct_change_wage_q2), 2)


# Question 3 (Quiz 10):
# Data: wage1. Using the same regression of log(wage) on educ, exper, and tenure,
# what is the predicted hourly wage, in dollars, of a worker with 12 years of
# education, 10 years of experience, and 3 years of tenure?
# Hint: predict log(wage) first, then undo the log with exp()
log_wage_hat_q3 <- b[1] + b[2] * 12 + b[3] * 10 + b[4] * 3
wage_hat_q3 <- exp(log_wage_hat_q3)
round(unname(wage_hat_q3), 2)


