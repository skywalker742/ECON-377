#### Question 20: E[Y | X = x] = subgroup average of Y
y_subgroup <- c(8, 5, 0, 11)           # Y values where X = x
E_Y_cond   <- mean(y_subgroup)         # average of those Y values
E_Y_cond                               # Output: 6

#### Question 21: Discrete conditional mean E[Y | X = x] = sum(yj * pj)
yj       <- c(7, 5, 5)                 # Y values given X = x
pj       <- c(0.2, 0.3, 0.5)           # conditional probabilities
E_Y_cond <- sum(yj * pj)               # sum of weighted values
round(E_Y_cond, 2)                     # Output: 5.4

#### Question 22: Linearity of conditional expectation E[aY + b | X = x]
E_Y_cond    <- 8
a           <- 3
b           <- 4
E_aY_b_cond <- a * E_Y_cond + b        # E[3Y + 4 | X = x] = 3*(8) + 4
