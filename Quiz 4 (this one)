#### ===== 3. Covariance & Correlation (Questions 15-19) =====

#### Question 15:
#### Covariance is Cov(X, Y) = E[XY] - E[X] E[Y]. 
#### Given E[XY] = 27, E[X] = 6, E[Y] = 3, find Cov(X, Y). (round to the hundredths) [5]
EXY <- 27
EX  <- 6
EY  <- 3
Cov <- EXY - EX * EY                  # Cov(X, Y) = 27 - (6*3) [6, 7]
Cov                                   # Output: 9.00


#### Question 16:
#### X and Y take the paired values (3, 1), (2, 1), (5, 1), each pair equally likely (probability 1/3). 
#### Find Cov(X, Y) = E[XY] - E[X] E[Y]. (round to the hundredths) [5]
xj  <- c(3, 2, 5)                      # x values for pairs [1, 3]
yj  <- c(1, 1, 1)                      # y values for pairs [1, 3]
pj  <- c(1/3, 1/3, 1/3)                # probabilities for each pair [1, 3]
EX  <- sum(xj * pj)                    # E[X]  = sum(xj * pj) [1, 8]
EY  <- sum(yj * pj)                    # E[Y]  = sum(yj * pj) [1, 8]
EXY <- sum(xj * yj * pj)               # E[XY] = sum(xj * yj * pj) [1, 8]
Cov <- EXY - EX * EY                   # Cov(X, Y) = E[XY] - E[X]*E[Y] [1, 7]
Cov                                    # Output: 0.00


#### Question 17:
#### A covariance property: Cov(a1 X + b1, a2 Y + b2) = a1 a2 Cov(X, Y). 
#### Given Cov(X, Y) = -1, a1 = 5, a2 = 3 (and any constants b1, b2), 
#### find Cov(a1 X + b1, a2 Y + b2). (round to the hundredths) [5]
Cov <- -1
a1  <- 5
a2  <- 3
Cov_trans <- a1 * a2 * Cov             # Cov(5X + b1, 3Y + b2) = 5*3*(-1)
Cov_trans                              # Output: -15.00


#### Question 18:
#### Correlation is Cor(X, Y) = Cov(X, Y) / (sd(X) sd(Y)). 
#### Given Cov(X, Y) = -2, sd(X) = 3, sd(Y) = 4, find Cor(X, Y). (round to the hundredths) [5]
Cov <- -2
sdX <- 3
sdY <- 4
Cor <- Cov / (sdX * sdY)              # Cor = -2 / (3 * 4) [7, 9]
round(Cor, 2)                         # Output: -0.17


#### Question 19:
#### Variance and covariance combine as Var(aX + bY) = a^2 Var(X) + b^2 Var(Y) + 2ab Cov(X, Y). 
#### Given Var(X) = 5, Var(Y) = 6, Cov(X, Y) = -1, a = 1, b = 3, find Var(aX + bY). (round to the hundredths) [5]
VarX <- 5
VarY <- 6
Cov  <- -1
a    <- 1
b    <- 3
Var_comb <- (a^2) * VarX + (b^2) * VarY + 2 * a * b * Cov
Var_comb                               # Output: 53.00


#### ===== 4. Conditional Expectation (Questions 20-22) =====

#### Question 20:
#### Among the observations with X = x, the Y values are 8, 5, 0, 11. 
#### Find E[Y | X = x] (the subgroup average). (round to the hundredths) [5]
y_subgroup <- c(8, 5, 0, 11)           # Y values where X = x
E_Y_cond   <- mean(y_subgroup)         # average of subgroup Y values [10]
E_Y_cond                               # Output: 6.00


#### Question 21:
#### Given X = x, Y takes values 7, 5, 5 with probabilities 0.2, 0.3, 0.5. 
#### Find E[Y | X = x]. (round to the hundredths) [5]
yj       <- c(7, 5, 5)                 # Y values given X = x
pj       <- c(0.2, 0.3, 0.5)           # conditional probabilities
E_Y_cond <- sum(yj * pj)               # sum of weighted values [8]
round(E_Y_cond, 2)                     # Output: 5.40


#### Question 22:
#### Conditional expectation is also linear: E[aY + b | X = x] = a E[Y | X = x] + b. 
#### Given E[Y | X = x] = 8, a = 3, b = 4, find E[aY + b | X = x]. (round to the hundredths) [5]
E_Y_cond    <- 8
a           <- 3
b           <- 4
E_aY_b_cond <- a * E_Y_cond + b        # E[3Y + 4 | X = x] = 3*(8) + 4
E_aY_b_cond                            # Output: 28.00
