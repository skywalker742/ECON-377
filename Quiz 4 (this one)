#### ===== 1. Linearity of Expectation (Questions 8-10) =====

#### Question 8:
#### Expectation is linear: E[aX + b] = a E[X] + b. 
#### Given E[X] = 1, a = 6, and b = 3, find E[aX + b]. (round to the hundredths) [4]
EX <- 1
a  <- 6
b  <- 3
E_aX_b <- a * EX + b                   # E[6X + 3] = 6*(1) + 3
E_aX_b                                 # Output: 9.00


#### Question 9:
#### Given E[X] = 8, E[Y] = 3, a = 5, and b = 2, 
#### find E[aX + bY] = a E[X] + b E[Y]. (round to the hundredths) [4]
EX <- 8
EY <- 3
a  <- 5
b  <- 2
E_aX_bY <- a * EX + b * EY             # E[5X + 2Y] = 5*(8) + 2*(3)
E_aX_bY                                # Output: 46.00


#### Question 10:
#### Given E[X] = 4, E[Y] = 7, 
#### find E[aX + bY - c] = a E[X] + b E[Y] - c with a = 4, b = 3, c = 7. (round to the hundredths) [4]
EX    <- 4
EY    <- 7
a     <- 4
b     <- 3
c_val <- 7
E_comb <- a * EX + b * EY - c_val      # E[4X + 3Y - 7] = 4*(4) + 3*(7) - 7
E_comb                                 # Output: 30.00


