# Question 12 (Quiz 9):
# A multiple regression gives y_hat = 7 + 2.9 * x1 + 1.2 * x2.
# Find the predicted value y_hat at x1 = 11 and x2 = 12.
# Hint: plug both values in, exactly as in simple regression.
b0_q12 <- 7
b1_q12 <- 2.9
b2_q12 <- 1.2
x1_q12 <- 11
x2_q12 <- 12
y_hat_q12 <- b0_q12 + b1_q12 * x1_q12 + b2_q12 * x2_q12
round(y_hat_q12, 2)


# Question 13 (Quiz 9):
# A multiple regression gives y_hat = 2 + 2.4 * x1 - 2.5 * x2.
# If x1 rises by 6 and x2 rises by 2, by how much does y_hat change?
# Hint: delta_y_hat = beta1_hat * delta_x1 + beta2_hat * delta_x2.
b1_q13 <- 2.4
b2_q13 <- -2.5
delta_x1_q13 <- 6
delta_x2_q13 <- 2
delta_y_hat_q13 <- b1_q13 * delta_x1_q13 + b2_q13 * delta_x2_q13
round(delta_y_hat_q13, 2)


# Question 14 (Quiz 9):
# Data: wage1. Run reg <- lm(wage ~ educ + exper + tenure, data = wage1).
# What is the predicted hourly wage of a worker with 14 years of education, 10 years of experience, and 5 years of tenure?
data("wage1")
reg_q14 <- lm(wage ~ educ + exper + tenure, data = wage1)
b_q14 <- coef(reg_q14)
y_hat_q14 <- b_q14[1] + b_q14["educ"] * 14 + b_q14["exper"] * 10 + b_q14["tenure"] * 5
round(unname(y_hat_q14), 2)


# Question 15 (Quiz 9):
# Data: wage1. Using the same regression of wage on educ, exper, and tenure,
# by how much does the predicted hourly wage change when tenure rises by 3 years, holding education and experience fixed?
# Hint: delta_wage_hat = beta3_hat * delta_tenure
b_tenure_q15 <- coef(reg_q14)["tenure"]
delta_tenure_q15 <- 3
delta_wage_q15 <- b_tenure_q15 * delta_tenure_q15
round(unname(delta_wage_q15), 2)



# Question 21:
# Data: wage1. Run the multiple regression lm(wage ~ educ + exper, data = wage1)
# and the regression of the omitted variable on the included one, lm(exper ~ educ, data = wage1).
# Compute beta2_hat * delta1_tilde, the exper coefficient from the first regression times the educ slope from the second.
reg_mult_q21 <- lm(wage ~ educ + exper, data = wage1)
reg_aux_q21 <- lm(exper ~ educ, data = wage1)
beta2_hat_q21 <- coef(reg_mult_q21)["exper"]
delta1_tilde_q21 <- coef(reg_aux_q21)["educ"]
ovb_q21 <- beta2_hat_q21 * delta1_tilde_q21
round(unname(ovb_q21), 2)
