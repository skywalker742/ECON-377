# ==============================================================================
# PART 5: DIRECTION OF OMITTED-VARIABLE BIAS (Questions 16 - 19)
# ==============================================================================
# Table 3.2: Bias(beta1_tilde) = beta2 * delta1_tilde, and delta1_tilde has the
# sign of Cor(X1, X2).

# Question 16 (Quiz 10):
# An omitted variable X2 lowers Y (beta2 < 0), and X2 is negatively correlated with
# the included X1 (delta1_tilde < 0). The simple-regression slope on X1 is:
beta2_sign_q16   <- -1
delta1_sign_q16  <- -1
bias_sign_q16 <- beta2_sign_q16 * delta1_sign_q16   # +1 means upward bias
bias_sign_q16
q16_answer <- "biased upward"
print(q16_answer)


# Question 17 (Quiz 10):
# A researcher regresses crop yield on fertilizer use, leaving out land quality.
# Better land raises yield (beta2 > 0), and farmers use more fertilizer on better land
# (delta1_tilde > 0). The simple-regression fertilizer slope most likely:
beta2_sign_q17   <- 1
delta1_sign_q17  <- 1
bias_sign_q17 <- beta2_sign_q17 * delta1_sign_q17
bias_sign_q17
q17_answer <- "overstates the effect of fertilizer (upward bias)"
print(q17_answer)


# Question 18:
# A school regresses exam scores on hours of tutoring, leaving out prior ability.
# Higher ability raises scores (beta2 > 0), but students who sign up for the most
# tutoring tend to have lower prior ability (delta1_tilde < 0).
beta2_sign_q18   <- 1
delta1_sign_q18  <- -1
bias_sign_q18 <- beta2_sign_q18 * delta1_sign_q18   # -1 means downward bias
bias_sign_q18
q18_answer <- "understates the effect of tutoring (downward bias)"
print(q18_answer)


# Question 19:
# You regress Y on X1 alone, leaving out X2. When does this cause NO omitted-variable
# bias in the slope on X1? Select all that apply.
# Hint: Bias(beta1_tilde) = beta2 * delta1_tilde is zero when either leg is zero.
q19_answer <- c(
  "X2 is uncorrelated with X1 in the sample (delta1_tilde = 0).",
  "X2 has no ceteris-paribus effect on Y (beta2 = 0)."
)
print(q19_answer)
