# Question 11 (Quiz 10):
# Formula (3.23): beta1_tilde = beta1_hat + beta2_hat * delta1_tilde.
# The simple regression of Y on X1 gives beta1_tilde = -0.36. The multiple regression
# gives beta2_hat = -1.18, and the slope from regressing X2 on X1 is delta1_tilde = -0.51.
# Find the multiple-regression slope beta1_hat.
# Hint: solve (3.23) for beta1_hat: beta1_hat = beta1_tilde - beta2_hat * delta1_tilde
beta1_tilde_q11 <- -0.36
beta2_hat_q11 <- -1.18
delta1_tilde_q11 <- -0.51
beta1_hat_q11 <- beta1_tilde_q11 - beta2_hat_q11 * delta1_tilde_q11
round(beta1_hat_q11, 2)


