# Question 7 (Quiz 10):
# Which of these regressions violate MLR3 (no perfect collinearity), so that OLS
# cannot estimate them? Select all that apply.
q7_answer <- c(
  "wage on income in dollars and income in thousands of dollars",
  "voteA on expendA, expendB and totexpend, where totexpend = expendA + expendB",
  "a regression with 5 independent variables, estimated on 4 observations"
)
print(q7_answer)
# NOT violations: wage on educ and exper (both vary), and colGPA on ACT and hsGPA
# (positively correlated, but not perfectly).


# Question 8:
# Data: vote1. Create totexpend <- expendA + expendB, then run
# lm(voteA ~ expendA + expendB + totexpend, data = vote1).
# What does R report for the coefficient on totexpend?
# Hint: run it and look at the output. Can you change totexpend while holding
# expendA and expendB fixed?
data("vote1")
vote1$totexpend <- vote1$expendA + vote1$expendB
reg_q8 <- lm(voteA ~ expendA + expendB + totexpend, data = vote1)
summary(reg_q8)
coef(reg_q8)["totexpend"]    # NA
q8_answer <- "NA: R drops totexpend because it is an exact linear function of expendA and expendB."
print(q8_answer)


