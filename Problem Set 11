# Question 4 (Quiz 10):
# After an OLS multiple regression of Y on X1,...,XK (with an intercept) and
# residuals U_hat = Y - Y_hat, which statements are always true? Select all that apply.
q4_answer <- c(
  "The sample average of the residuals is 0.",
  "The regression passes through the point of sample means: Ybar = b0 + b1*X1bar + ... + bK*XKbar.",
  "The sample covariance between each Xj and the residuals is 0."
)
print(q4_answer)
# NOT true: cov(Y, residuals) = 0 (the residuals are uncorrelated with the FITTED
# values, not with Y itself), and "every residual is 0 in a large sample."

# Optional check using the wage1 regression from Question 2:
mean(resid(reg))                                  # approximately 0
cov(wage1$educ, resid(reg))                       # approximately 0
cov(wage1$exper, resid(reg))                      # approximately 0
cov(wage1$tenure, resid(reg))                     # approximately 0
cov(log(wage1$wage), resid(reg))                  # NOT 0 (cov with Y is not zero)
cov(fitted(reg), resid(reg))                      # approximately 0


# Question 5 (Quiz 10):
# Data: gpa1. Run reg <- lm(colGPA ~ ACT + hsGPA, data = gpa1).
# Compute the predicted colGPA at ACT = mean(gpa1$ACT) and hsGPA = mean(gpa1$hsGPA).
# Compare with mean(gpa1$colGPA). Why are they the same?
data("gpa1")
reg_q5 <- lm(colGPA ~ ACT + hsGPA, data = gpa1)
b_q5 <- reg_q5$coefficients
y_hat_q5 <- b_q5[1] + b_q5[2] * mean(gpa1$ACT) + b_q5[3] * mean(gpa1$hsGPA)
round(unname(y_hat_q5), 2)
round(mean(gpa1$colGPA), 2)
q5_answer <- "They are the same because the OLS regression passes through the point of sample means."
print(q5_answer)


# Question 6 (Quiz 10):
# A multiple regression gives y_hat = 8.4 + 1.6 * x1 - 0.9 * x2.
# The sample means are x1bar = 13.5 and x2bar = 4.9. What is the sample mean ybar?
# Hint: ybar = b0 + b1 * x1bar + b2 * x2bar
b0_q6 <- 8.4
b1_q6 <- 1.6
b2_q6 <- -0.9
x1bar_q6 <- 13.5
x2bar_q6 <- 4.9
ybar_q6 <- b0_q6 + b1_q6 * x1bar_q6 + b2_q6 * x2bar_q6
round(ybar_q6, 2)


