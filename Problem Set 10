# Question 1 (Quiz 9):
# A regression gives test_score_hat = 12 + 8 * log(income). What does the 8 mean?
q1_answer <- "A 1% rise in income is associated with a rise of about 0.08 points in the predicted test score."
print(q1_answer)


# Question 2 (Quiz 9):
# A log-level regression gives log(y_hat) = 0.5 + 0.06 * x.
# By about what percent does y change when x falls by 1?
# Hint: log-level: % delta y approx 100 * beta1_hat * delta_x
beta1_hat_q2 <- 0.06
delta_x_q2   <- -1
pct_change_y_q2 <- 100 * beta1_hat_q2 * delta_x_q2
round(pct_change_y_q2, 2)


# Question 3 (Quiz 9):
# Data: bwght. Run the log-log regression lm(log(bwght) ~ log(faminc), data = bwght).
# By about what percent does predicted birth weight change when family income rises by 20%?
# Hint: log-log: % delta y approx beta1_hat * % delta x

data("bwght")
reg_q3 <- lm(log(bwght) ~ log(faminc), data = bwght)
beta1_hat_q3   <- unname(coef(reg_q3)["log(faminc)"])
pct_delta_x_q3 <- 20
pct_change_y_q3 <- beta1_hat_q3 * pct_delta_x_q3
round(pct_change_y_q3, 2)


