# Question 4 (Quiz 9):
# Suppose you could draw 1,000 different random samples from the same population
# and compute beta1_hat in each one. If OLS is unbiased (SLR1-SLR4 hold), which statement is correct?
q4_answer <- "The average of the 1,000 estimates is close to beta1."
print(q4_answer)


# Question 5:
# Why do we prefer an unbiased estimator with a smaller variance Var(beta1_hat)?
q5_answer <- "Its estimates land closer to beta1 from sample to sample, so any one estimate is more reliable."
print(q5_answer)


# Question 6 (Quiz 9):
# Under SLR1-SLR5, Var(beta1_hat) = sigma^2 / SST_X.
# Holding everything else fixed, which changes would make Var(beta1_hat) larger? Select all that apply.
q6_answer <- c(
  "X values bunched more tightly together (a smaller SST_X)",
  "A larger error variance sigma^2",
  "A smaller sample (fewer observations with X spread the same way, so a smaller SST_X)"
)
print(q6_answer)


# Question 7 (Quiz 9):
# A simple regression on n = 9 observations has sigma_hat = 7.7, and Sx = 2.5.
# Find the standard error se(beta1_hat).
# Hint: SST_X = (n - 1) * Sx^2, then se(beta1_hat) = sigma_hat / sqrt(SST_X)
n_q7 <- 9
sigma_hat_q7 <- 7.7
Sx_q7 <- 2.5
sst_x_q7 <- (n_q7 - 1) * (Sx_q7^2)
se_beta1_hat_q7 <- sigma_hat_q7 / sqrt(sst_x_q7)
round(se_beta1_hat_q7, 2)


# Question 8:
# A simple regression uses the five X values x = (3, 5, 6, 8, 9) and has SSR = 37.
# Find the standard error se(beta1_hat).
# Hint: with n = 5, sigma_hat = sqrt(SSR / (n - 2)). Then SST_X = sum((x - xbar)^2) and se = sigma_hat / sqrt(SST_X)
x_q8 <- c(3, 5, 6, 8, 9)
n_q8 <- length(x_q8)
ssr_q8 <- 37
sigma_hat_q8 <- sqrt(ssr_q8 / (n_q8 - 2))
sst_x_q8 <- sum((x_q8 - mean(x_q8))^2)
se_beta1_hat_q8 <- sigma_hat_q8 / sqrt(sst_x_q8)
round(se_beta1_hat_q8, 2)


# Question 9 (Quiz 9):
# Under SLR1-SLR5, a regression has sd(beta1_hat) = 1.84.
# If the sample were 10 times as large, with the X values spread out in the same way
# (so SST_X is also 10 times as large), what would sd(beta1_hat) be?
# Hint: sd(beta1_hat) = sigma / sqrt(SST_X). Multiplying SST_X by k divides the sd by sqrt(k).
sd_old_q9 <- 1.84
k_q9 <- 10
sd_new_q9 <- sd_old_q9 / sqrt(k_q9)
round(sd_new_q9, 2)


# Question 10:
# Data: ceosal1. Run reg <- lm(salary ~ roe, data = ceosal1).
# Compute the standard error se(beta1_hat) by hand from sigma_hat and SST_X.
# Hint: sigma_hat = sqrt(SSR / (n - 2)) and SST_X = sum((ceosal1$roe - mean(ceosal1$roe))^2).

data("ceosal1")
reg_q10 <- lm(salary ~ roe, data = ceosal1)
n_q10 <- nrow(ceosal1)
ssr_q10 <- sum(residuals(reg_q10)^2)
sigma_hat_q10 <- sqrt(ssr_q10 / (n_q10 - 2))
sst_x_q10 <- sum((ceosal1$roe - mean(ceosal1$roe))^2)
se_beta1_hat_q10 <- sigma_hat_q10 / sqrt(sst_x_q10)
round(se_beta1_hat_q10, 2)


