# Question 18:
# Formula links simple and multiple regression slopes: beta1_tilde = beta1_hat + beta2_hat * delta1_tilde
# The multiple regression of Y on X1 and X2 gives beta1_hat = 0.25 and beta2_hat = 1.44.
# The slope from regressing X2 on X1 is delta1_tilde = 0.11.
# Find the simple-regression slope beta1_tilde from regressing Y on X1 alone.
beta1_hat_q18 <- 0.25
beta2_hat_q18 <- 1.44
delta1_tilde_q18 <- 0.11
beta1_tilde_q18 <- beta1_hat_q18 + beta2_hat_q18 * delta1_tilde_q18
round(beta1_tilde_q18, 2)


# Question 19:
# In the population, Y = beta0 + beta1 * X1 + beta2 * X2 + U with beta2 = 0.69.
# You omit X2 and regress Y on X1 alone, and the slope from regressing X2 on X1 is delta1_tilde = 0.25.
# What is the bias of the simple-regression slope, Bias(beta1_tilde) = E[beta1_tilde] - beta1?
beta2_q19 <- 0.69
delta1_tilde_q19 <- 0.25
bias_q19 <- beta2_q19 * delta1_tilde_q19
round(bias_q19, 2)


# Question 20:
# An omitted variable X2 lowers Y (beta2 < 0), and X2 is positively correlated with X1.
# The simple-regression slope on X1 is:
q20_answer <- "biased downward"
print(q20_answer)


# Question 21:
# Data: wage1. Run the multiple regression lm(wage ~ educ + exper, data = wage1)
# and the regression of the omitted variable on the included one, lm(exper ~ educ, data = wage1).
# Compute beta2_hat * delta1_tilde, the exper coefficient from the first regression times the educ slope from the second.
reg_mult_q21 <- lm(wage ~ educ + exper, data = wage1)
reg_aux_q21 <- lm(exper ~ educ, data = wage1)
beta2_hat_q21 <- coef(reg_mult_q21)["exper"]
delta1_tilde_q21 <- coef(reg_aux_q21)["educ"]
ovb_q21 <- beta2_hat_q21 * delta1_tilde_q21
round(unname(ovb_q21), 2)

