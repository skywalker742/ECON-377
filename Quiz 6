# Question ___
# For x = (8, 3, 4), y = (1, 8, 7), fit OLS line and predict y_hat at x = 3.
x <- c(8, 3, 4)
y <- c(1, 8, 7)
fit11 <- lm(y ~ x)
y_hat_at_3 <- predict(fit11, newdata = data.frame(x = 3))
round(y_hat_at_3, 2)

# Question ___
# A fitted line is y_hat = 7 + (9/10)x. Find y_hat at x = 9.
b0 <- 7
b1 <- 9/10
x_val <- 9
y_hat <- b0 + b1 * x_val
round(y_hat, 2)

# Question ___
# A fitted line is y_hat = -2 + (7/10)x. Actual x = 8, y = 20. Find u_hat = y - y_hat.
b0 <- -2
b1 <- 7/10
x_val <- 8
y_actual <- 20
y_hat <- b0 + b1 * x_val
u_hat <- y_actual - y_hat
round(u_hat, 2)

# Question ___
# A fitted slope is beta1_hat = 6/10. Find predicted change in y when x rises by 6.
beta1_hat <- 6/10
delta_x <- 6
delta_y_hat <- beta1_hat * delta_x
round(delta_y_hat, 2)

# Question ___
# For fitted line y_hat = 0 + (5/10)x and points (5,11), (3,10), (10,9), find SSR.
b0 <- 0
b1 <- 5/10
x_pts <- c(5, 3, 10)
y_pts <- c(11, 10, 9)
y_hat_pts <- b0 + b1 * x_pts
u_pts <- y_pts - y_hat_pts
SSR <- sum(u_pts^2)
round(SSR, 2)

# Question ___
# SST = 323, SSR = 150. Find SSE.
SST <- 323
SSR <- 150
SSE <- SST - SSR
round(SSE, 2)

# Question ___
# SST = 276, SSR = 34. Find R^2.
SST <- 276
SSR <- 34
SSE <- SST - SSR
R2 <- SSE / SST
round(R2, 2)

