# Question ___
# For x = (1, 6, 6), y = (8, 2, 6), find OLS slope beta1_hat.
x <- c(1, 6, 6)
y <- c(8, 2, 6)
fit9 <- lm(y ~ x)
beta1_hat <- coef(fit9)[2]
round(beta1_hat, 2)

