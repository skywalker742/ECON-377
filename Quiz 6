# Question ___
# SST = 376, SSR = 88. Find fraction of variation UNEXPLAINED.
SST <- 376
SSR <- 88
unexplained_frac <- SSR / SST
round(unexplained_frac, 2)

# Question ___
# SST = 345, R^2 = 37/100. Find SSR.
SST <- 345
R2 <- 37/100
SSR <- SST * (1 - R2)
round(SSR, 2)
