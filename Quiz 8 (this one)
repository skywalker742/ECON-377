# Question 6:
# Data: ceosall (salary a CEO's 1990 salary in thousands of dollars; roe = the firm's return on equity, 
# in percent; sales = firm sales in millions of dollars). Run the log-level regression lm(log(salary) ~ roe, data = ceosall). 
# By about what percent does predicted salary change when return on equity rises by 5 points? 
# (Give a percent. Use the unrounded slope.) (round to the hundredths)
# Hint: use the log-level row of Table 2.3 with delta roe = 5
# Note: Requires the 'wooldridge' package. Uncomment install.packages line if needed.
# install.packages("wooldridge")
library(wooldridge)
data(ceosall)
reg_q6 <- lm(log(salary) ~ roe, data = ceosall)
beta1_hat_q6 <- coef(reg_q6)["roe"]
delta_roe_q6 <- 5
pct_change_q6 <- 100 * beta1_hat_q6 * delta_roe_q6
round(pct_change_q6, 2)

